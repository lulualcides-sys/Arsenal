/* Pokemon Tower vertical slice for GBurgardt/pokemon-emerald-arena.
 * Included by realtime_arena.c, using the native trainer/wild battle setup.
 * The arena's original animation/AI/damage code is NOT replaced.
 * 
 * This is a FIRST INTEGRATION, not a ROM verified build.
 */
#include "arena_tower_progress.h"
#include "constants/vars.h"
#include "constants/trainer_types.h"

#define VAR_TOWER_STAGE VAR_UNUSED_0x40F7
#define VAR_TOWER_STARTER VAR_UNUSED_0x40F8
#define VAR_TOWER_PENDING VAR_UNUSED_0x40F9
#define VAR_TOWER_LOCKED VAR_UNUSED_0x40FA

extern const u8 EventScript_ArenaTowerReturn[];
extern const u8 EventScript_ArenaPracticeBattle[];

struct TowerPartySpec {
    u16 species[3];
    u8 level[3];
    u16 move[3];
    u8 count;
};

/* Six preliminary trainers, then the seventh fight is the gym leader.
 * Only stages 0..13 are implemented. All enemy mons are generated by
 * Emerald's native CreateMon, so stats and PP remain engine-owned.
 * The first gym is Flying (Winona), the second is Water (Juan).
 */
static const struct TowerPartySpec sTowerFights[TOWER_TOTAL_STEPS] = {
    {{SPECIES_WINGULL,0,0},       {5,0,0},     {MOVE_GUST,0,0},          1},
    {{SPECIES_ZUBAT,0,0},      {6,0,0},     {MOVE_ASTONISH,0,0},          1},
    {{SPECIES_TAILLOW,0,0},     {7,0,0},     {MOVE_PECK,0,0},          1},
    {{SPECIES_BEAUTIFLY,0,0},   {8,0,0},     {MOVE_GUST,0,0},          1},
    {{SPECIES_GOLBAT,0,0},    {10,0,0},    {MOVE_BITE,0,0},          1},
    {{SPECIES_PELIPPER,0,0},       {11,0,0},    {MOVE_PECK,0,0},          1},
    {{SPECIES_PELIPPER,SPECIES_SWELLOW,0}, {13,14,0}, {MOVE_GUST,MOVE_WING_ATTACK,0}, 2},
    {{SPECIES_LOTAD,0,0},      {14,0,0},    {MOVE_ABSORB,0,0},     1},
    {{SPECIES_GOLDEEN,0,0},      {15,0,0},    {MOVE_PECK,0,0},          1},
    {{SPECIES_MARILL,0,0},       {16,0,0},    {MOVE_BUBBLE,0,0},        1},
    {{SPECIES_TENTACOOL,0,0},    {17,0,0},    {MOVE_ACID,0,0},          1},
    {{SPECIES_CARVANHA,0,0},      {18,0,0},    {MOVE_BITE,0,0},     1},
    {{SPECIES_WARTORTLE,0,0},    {20,0,0},    {MOVE_WATER_GUN,0,0},     1},
    {{SPECIES_LOMBRE,SPECIES_CARVANHA,SPECIES_SEALEO}, {21,22,24},
       {MOVE_ABSORB,MOVE_BITE,MOVE_WATER_GUN}, 3}
};

static const u8 sTowerVictoryText[] = _("Great battle!");
static EWRAM_DATA u8 sTowerTrainerScript[16];

static u16 TowerTrainerAt(u16 stage)
{
    u16 trainer, seen = 0;
    u8 gym = TowerGym(stage);
    u8 fight = TowerFight(stage);
    u8 desiredClass = gym == 0 ? TRAINER_CLASS_BIRD_KEEPER : TRAINER_CLASS_SWIMMER_M;
    if (fight == TOWER_TRAINERS_PER_GYM)
        return gym == 0 ? TRAINER_WINONA_1 : TRAINER_JUAN_1;
    /* These are genuine distinct trainer identities with the correct class.
       Their team is tuned separately for the tower in the party hook. */
    for (trainer = 1; trainer < TRAINERS_COUNT; trainer++)
    {
        if (gTrainers[trainer].trainerClass != desiredClass
         || gTrainers[trainer].doubleBattle || !gTrainers[trainer].partySize)
            continue;
        if (seen++ == fight) return trainer;
    }
    return gym == 0 ? TRAINER_ALBERTO : TRAINER_DECLAN;
}

/* Hook called at the point where vanilla battle_main.c has just populated
 * the native enemy party. Never invoked for ordinary game battles. */
void RealtimeArena_TowerAdjustEnemyParty(void)
{
    u16 stage, pending, trainer;
    const struct TowerPartySpec *f;
    u8 i;
    if (!FlagGet(FLAG_ARENA_PRACTICE)) return;
    pending = VarGet(VAR_TOWER_PENDING);
    if (!pending) return;
    stage = pending - 1;
    if (stage >= TOWER_TOTAL_STEPS || !(gBattleTypeFlags & BATTLE_TYPE_TRAINER)) return;
    trainer = TowerTrainerAt(stage);
    if (gTrainerBattleOpponent_A != trainer) return;
    f = &sTowerFights[stage];
    ZeroEnemyPartyMons();
    for (i = 0; i < f->count; i++)
    {
        CreateMon(&gEnemyParty[i], f->species[i], f->level[i], 20,
                  TRUE, i * 3, OT_ID_PLAYER_ID, 0);
        SetMonMoveSlot(&gEnemyParty[i], f->move[i], 0);
    }
}

static void TowerPickStarter(s8 delta)
{
    static const u16 starters[3] = {SPECIES_BULBASAUR,SPECIES_CHARMANDER,SPECIES_SQUIRTLE};
    u16 selected = VarGet(VAR_TOWER_STARTER);
    if (VarGet(VAR_TOWER_LOCKED) || VarGet(VAR_TOWER_STAGE)) return;
    selected = (selected + 3 + delta) % 3;
    VarSet(VAR_TOWER_STARTER, selected);
    ZeroPlayerPartyMons();
    CreateMon(&gPlayerParty[0], starters[selected], 5, 20, TRUE, 0, OT_ID_PLAYER_ID, 0);
    gPlayerPartyCount = 1;
    /* Check the party screen to see the selected starter. */
}

static bool8 TowerHasUsableMon(void)
{
    u8 i;
    for (i = 0; i < gPlayerPartyCount; i++)
        if (GetMonData(&gPlayerParty[i], MON_DATA_HP)
            && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)) return TRUE;
    return FALSE;
}

static void TowerStartTrainer(void)
{
    u16 stage = VarGet(VAR_TOWER_STAGE);
    u16 trainer;
    u32 defeatText = (u32)sTowerVictoryText;
    if (TowerIsComplete(stage) || !TowerHasUsableMon()) return;
    trainer = TowerTrainerAt(stage);
    memset(sTowerTrainerScript, 0, sizeof(sTowerTrainerScript));
    sTowerTrainerScript[0] = TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT;
    sTowerTrainerScript[1] = trainer;
    sTowerTrainerScript[2] = trainer >> 8;
    sTowerTrainerScript[5] = defeatText;
    sTowerTrainerScript[6] = defeatText >> 8;
    sTowerTrainerScript[7] = defeatText >> 16;
    sTowerTrainerScript[8] = defeatText >> 24;
    sTowerTrainerScript[9] = EventScript_ArenaTowerReturn[0];
    sTowerTrainerScript[10] = EventScript_ArenaTowerReturn[1];
    /* Save persistent pending stage before battle to prevent premature rewards. */
    VarSet(VAR_TOWER_PENDING, stage + 1);
    VarSet(VAR_TOWER_LOCKED, 1);
    BattleSetup_ConfigureTrainerBattle(sTowerTrainerScript);
    ScriptContext_SetupScript(EventScript_ArenaTowerReturn);
    LockPlayerFieldControls();
    BattleSetup_StartTrainerBattle();
}

static void TowerStartGrass(void)
{
    static const u16 birds[3] = {SPECIES_WINGULL, SPECIES_ZUBAT, SPECIES_TAILLOW};
    static const u16 water[3] = {SPECIES_LOTAD, SPECIES_MARILL, SPECIES_MAGIKARP};
    u16 stage = VarGet(VAR_TOWER_STAGE);
    u16 idx;
    if (!TowerHasUsableMon() || TowerIsComplete(stage)) return;
    idx = (GetGameStat(GAME_STAT_WILD_BATTLES) + stage) % 3;
    /* First capture attempt locks the starter to avoid wiping a caught party. */
    VarSet(VAR_TOWER_LOCKED, 1);
    CreateScriptedWildMon(TowerGym(stage) == 0 ? birds[idx] : water[idx],
                          TowerGym(stage) == 0 ? 5 + idx : 12 + idx, ITEM_NONE);
    ScriptContext_SetupScript(EventScript_ArenaPracticeBattle);
}

static void TowerAfterFight(void)
{
    u16 pending = VarGet(VAR_TOWER_PENDING);
    u16 stage = VarGet(VAR_TOWER_STAGE);
    if (!pending || gMain.inBattle) return;
    /* Progression only follows a verified win over the stage that was started.
       Losing, resetting, fleeing or switching battles must never advance. */
    if (pending == stage + 1 && gBattleOutcome == B_OUTCOME_WON)
    {
        VarSet(VAR_TOWER_STAGE, TowerAdvance(stage, TOWER_RESULT_WIN));
        if (TowerIsBoss(stage))
        {
            AddBagItem(ITEM_GREAT_BALL, 3);
            HealPlayerParty();
        }
    }
    VarSet(VAR_TOWER_PENDING, 0);
}

void RealtimeArena_PracticeTick(void)
{
    ArenaExpFieldTick();
    if (!FlagGet(FLAG_ARENA_PRACTICE) || gPaletteFade.active
        || ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled()) return;
    TowerAfterFight();
    if (JOY_HELD(L_BUTTON | R_BUTTON) == (L_BUTTON | R_BUTTON)
         && JOY_NEW(L_BUTTON | R_BUTTON))
    {
        TowerStartTrainer();
        return;
    }
    if (JOY_HELD(A_BUTTON | B_BUTTON) == (A_BUTTON | B_BUTTON)
         && JOY_NEW(A_BUTTON | B_BUTTON))
    {
        TowerStartGrass();
        return;
    }
    if (JOY_NEW(L_BUTTON) && !JOY_HELD(R_BUTTON)) TowerPickStarter(-1);
    else if (JOY_NEW(R_BUTTON) && !JOY_HELD(L_BUTTON)) TowerPickStarter(1);
}
